<div id="contents">
    <div class="box">
        <div>
            <div class="body">
                <h1>Travel Packages</h1>
                <ul id="rooms">
                    {{#each trips}}
                    <li>
                        <a href="/api/trips/{{this.code}}"><img src="/images/{{this.image}}" alt="generic"></a>
                        <h2><a href="/travel">{{this.name}}</a></h2>
                        <h5>{{this.resort}}</h5>
                        <p class="rate">From ${{this.perPerson}} Per Person</p>
                        <p>{{{this.description}}}</p>
                    </li>
                    {{#unless @last}}<hr>{{/unless}} {{/each}}
                </ul>
            </div>
        </div>
    </div>
</div>
